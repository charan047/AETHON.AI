FROM python:3.11-slim

# Install commonly needed data science packages.
# This pre-built image speeds up execution significantly.
RUN pip install --no-cache-dir \
    requests==2.31.0 \
    pandas==2.2.0 \
    numpy==1.26.4 \
    matplotlib==3.8.0 \
    scipy==1.13.0 \
    openpyxl==3.1.2 \
    python-dateutil==2.9.0

# Remove pip to reduce attack surface.
RUN pip uninstall pip -y

# No shell, no bash usage from the tool path - python only.
USER nobody
