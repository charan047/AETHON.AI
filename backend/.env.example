# ─── Core Platform ────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://platform_user:platform_pass@localhost:5432/platform_db
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

ENVIRONMENT=development
RUN_MIGRATIONS_ON_STARTUP=false
ENABLE_TESTING_API=false
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
POD_ID=

# ─── Database / Runtime Tuning ────────────────────────────────
DB_POOL_SIZE=25
DB_MAX_OVERFLOW=50
HITL_TIMEOUT_HOURS=24
DOCKER_EXECUTION_IMAGE=platform-executor:latest

# ─── AI Models ────────────────────────────────────────────────
DEFAULT_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=agent_memory

# Real OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# OpenAI-compatible endpoints: Groq, Together, OpenRouter, LM Studio, etc.
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=

# Local Ollama
OLLAMA_BASE_URL=http://localhost:11434

# ─── Search / Research ────────────────────────────────────────
TAVILY_API_KEY=

# ─── Google OAuth ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Stripe Billing ───────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_FREE_PRICE_ID=
STRIPE_SOLO_PRICE_ID=
STRIPE_TEAM_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
STRIPE_METERED_EXECUTION_PRICE_ID=

# ─── Telegram (optional) ──────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Observability / Budgets ──────────────────────────────────
OTLP_ENDPOINT=
DEFAULT_MONTHLY_BUDGET_USD=50.0
